# Copy to .env and adjust. Never commit .env.
# Database: SQLite by default; Docker Compose sets PostgreSQL.
NEXORA_DATABASE_URL=sqlite:///./nexora.db
# Password of the local PostgreSQL container (Docker Compose).
POSTGRES_PASSWORD=change-me
# AI analysis. With no key, a scripted stand-in (no model, no network) is used.
# With a key (https://aistudio.google.com/apikey), Gemini analyses the requests.
GEMINI_API_KEY=
# auto (Gemini when a key is set), gemini or scripted
NEXORA_LLM_PROVIDER=auto
NEXORA_GEMINI_MODEL=gemini-3.5-flash-lite
