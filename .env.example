# Copy to .env and adjust. Never commit .env.
# Database: SQLite by default; Docker Compose sets PostgreSQL.
NEXORA_DATABASE_URL=sqlite:///./nexora.db
# Password of the local PostgreSQL container (Docker Compose).
POSTGRES_PASSWORD=change-me
# AI analysis. With no key, a scripted stand-in (no model, no network) is used.
# Mistral (https://console.mistral.ai/api-keys) is used when its key is set,
# otherwise Gemini (https://aistudio.google.com/apikey) when its key is set.
MISTRAL_API_KEY=
GEMINI_API_KEY=
# auto, mistral, gemini or scripted
NEXORA_LLM_PROVIDER=auto
NEXORA_MISTRAL_MODEL=mistral-small-latest
NEXORA_GEMINI_MODEL=gemini-3.5-flash-lite
