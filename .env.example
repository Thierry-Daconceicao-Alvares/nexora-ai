# Copy to .env and adjust. Never commit .env.
# Database: SQLite by default; Docker Compose sets PostgreSQL.
NEXORA_DATABASE_URL=sqlite:///./nexora.db
# Password of the local PostgreSQL container (Docker Compose).
POSTGRES_PASSWORD=change-me
# Gemini API key: needed from Phase 4 (AI analysis). Leave empty until then.
GEMINI_API_KEY=
